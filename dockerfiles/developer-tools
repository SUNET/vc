# Compile
FROM docker.sunet.se/iam_vc/gobuild:local AS builder

# GOTOOLCHAIN=local, matching dockerfiles/worker. "auto" alongside
# GOPROXY=off is a contradiction: go.mod requires a newer Go than the base
# image may carry, auto then tries to DOWNLOAD that toolchain, and the
# disabled proxy denies it - which surfaces as "toolchain not available"
# rather than as the version mismatch it is. With local, the same stale
# base image fails saying go.mod needs a newer Go, which names the thing to
# fix.
ENV GOTOOLCHAIN=local
ENV GOFLAGS=-mod=vendor
ENV GOPROXY=off
ENV GONOSUMDB=*
ENV GONOSUMCHECK=*

# Copy source code (includes vendor/)
COPY . .

# Build with caching for both build cache and module cache
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    make build-gen-bootstrap \
    && make build-gen-config-docs \
    && make build-jwt-issuer

# Deploy — Alpine for minimal CVE surface (binary is statically linked)
FROM alpine:3.23

WORKDIR /

RUN apk add --no-cache ca-certificates

# Run as non-root user for security hardening
RUN addgroup -S vctools && adduser -S vctools -G vctools

COPY --from=builder /go/src/app/bin/gen_bootstrap /go/src/app/bin/gen_config_docs \
    /go/src/app/bin/jwt_issuer /usr/local/bin/

USER vctools
