{"id":"extensions-unknown-event-001","description":"An unrecognised event type survives a merge of divergent histories","version":"3","sections":["6.1.4","8"],"tags":["extensions","forward-compatibility","merge"],"inputs":{"historyA":[{"type":"a_type_this_reader_does_not_know","schemaVersion":3,"eventId":1,"parentHash":"","timestampSeconds":100}],"historyB":[{"type":"alter_settings","schemaVersion":3,"eventId":2,"parentHash":"","timestampSeconds":101,"settings":{"openidRefreshTokenMaxAgeInSeconds":"5"}}]},"validations":{"noThrow":"Merging MUST NOT raise; bucketing events by a fixed set of known types fails here","retained":"The unrecognised event MUST appear in the merged history","rationale":"A newer client's events must round-trip through an older client without loss or failure"}}
{"id":"extensions-concurrent-keys-001","description":"Two devices writing different keys in one namespace both survive the merge","version":"3","sections":["6.1.2","6.1.4"],"tags":["extensions","merge","concurrency"],"inputs":{"historyA":[{"type":"set_extension","schemaVersion":3,"eventId":1,"parentHash":"","timestampSeconds":100,"namespace":"org.siros.wscd","key":"kid-a1b2","value":"device-one-authenticator"}],"historyB":[{"type":"set_extension","schemaVersion":3,"eventId":2,"parentHash":"","timestampSeconds":101,"namespace":"org.siros.wscd","key":"kid-c3d4","value":"device-two-authenticator"}]},"validations":{"bothRetained":"S.extensions['org.siros.wscd'] MUST contain BOTH kid-a1b2 and kid-c3d4","rationale":"This is the case a per-subsystem key loses: one aggregate blob per plugin means last-write-wins discards an enrolled authenticator"}}
{"id":"extensions-tombstone-001","description":"A tombstone deletes, and is not resurrected by a peer at the fold horizon","version":"3","sections":["6.1.4"],"tags":["extensions","merge","tombstone"],"inputs":{"historyA":[{"type":"set_extension","schemaVersion":3,"eventId":1,"parentHash":"","timestampSeconds":100,"namespace":"org.siros.bbs","key":"1849302113","value":"holder-state"},{"type":"set_extension","schemaVersion":3,"eventId":2,"parentHash":"","timestampSeconds":300,"namespace":"org.siros.bbs","key":"1849302113","value":null}],"historyB":[{"type":"set_extension","schemaVersion":3,"eventId":3,"parentHash":"","timestampSeconds":200,"namespace":"org.siros.bbs","key":"1849302113","value":"stale-peer-state"}]},"validations":{"deleted":"S.extensions['org.siros.bbs'] MUST NOT contain 1849302113 after the merge","rationale":"The tombstone is the newest write; folding it away lets an older peer's value win"}}
{"id":"extensions-stale-peer-001","description":"A peer beyond the fold horizon is an unresolvable divergence, not a merge","version":"3","sections":["6.1.5"],"tags":["extensions","merge","fold-horizon"],"inputs":{"note":"Two histories with no reachable common ancestor, the ancestor having been folded into S"},"validations":{"noSilentMerge":"The implementation MUST NOT concatenate the histories and present the result as merged","userChoice":"The divergence MUST be surfaced so the user can choose which wallet is authoritative","rationale":"Concatenation yields an invalid event chain; failing opaquely leaves the user with no way forward"}}
{"id":"extensions-size-accounting-001","description":"Per-namespace size accounting is reported for a large container","version":"3","sections":["6.1.3"],"tags":["extensions","limits"],"inputs":{"container":"test-vectors/edge-cases/max-size-container.json"},"validations":{"perNamespace":"Sizes MUST be reportable per namespace, not only for the container as a whole","rationale":"Absolute size cannot be predicted; identifying the responsible namespace is what makes a limit actionable"}}
{"id":"extensions-lww-fold-order-001","description":"Folding an lww namespace is order-independent: a partial fold and a full fold converge","version":"3","sections":["6.1.5"],"tags":["extensions","fold","determinism"],"inputs":{"events":[{"type":"set_extension","schemaVersion":3,"eventId":1,"parentHash":"","timestampSeconds":100,"namespace":"org.siros.bbs","key":"cred-1","value":"v1"},{"type":"set_extension","schemaVersion":3,"eventId":2,"parentHash":"","timestampSeconds":200,"namespace":"org.siros.bbs","key":"cred-1","value":"v2"},{"type":"set_extension","schemaVersion":3,"eventId":3,"parentHash":"","timestampSeconds":300,"namespace":"org.siros.bbs","key":"cred-1","value":"v3"}],"foldPrefixLengths":[0,1,2,3]},"validations":{"converges":"Folding any prefix and then applying the remainder MUST yield value v3","rationale":"This is what lets a client fold an lww namespace it does not understand without making the outcome depend on which client folded"}}
{"id":"extensions-lww-tiebreak-001","description":"Equal timestamps are broken by eventId, deterministically","version":"3","sections":["6.1.5"],"tags":["extensions","merge","determinism"],"inputs":{"historyA":[{"type":"set_extension","schemaVersion":3,"eventId":7,"parentHash":"","timestampSeconds":100,"namespace":"org.siros.wscd","key":"kid-a1b2","value":"from-A"}],"historyB":[{"type":"set_extension","schemaVersion":3,"eventId":9,"parentHash":"","timestampSeconds":100,"namespace":"org.siros.wscd","key":"kid-a1b2","value":"from-B"}]},"validations":{"deterministic":"The merged value MUST be 'from-B' (greater eventId at equal timestamp), on every client","rationale":"Ordering on timestamp alone leaves two clients free to disagree about identical input"}}
{"id":"extensions-unknown-namespace-retained-001","description":"A client ignores, but preserves, extension events for a namespace it does not recognise","version":"3","sections":["6.1.5","6.1.3"],"tags":["extensions","forward-compatibility"],"inputs":{"events":[{"type":"set_extension","schemaVersion":3,"eventId":1,"parentHash":"","timestampSeconds":100,"namespace":"com.example.not.registered.here","key":"k","value":"opaque"}]},"validations":{"notAnError":"An unrecognised namespace MUST NOT be treated as an error","retained":"The event MUST remain in events after a merge, and its state MUST NOT be discarded","rationale":"A client must be able to carry state for a data kind it has not yet learned"}}
{"id":"extensions-version-coexistence-001","description":"Two versions of one namespace coexist; neither client deletes the other's state","version":"3","sections":["6.1.7"],"tags":["extensions","versioning","coexistence"],"inputs":{"state":{"extensions":{"org.siros.bbs":{"cred-old":"v1-shaped-holder-state"},"org.siros.bbs/v2":{"cred-new":"v2-shaped-holder-state"}}},"clientSupport":["org.siros.bbs/v2"]},"validations":{"bothRetained":"A client supporting only org.siros.bbs/v2 MUST leave org.siros.bbs entries intact","noMigration":"The client MUST NOT be required to produce v2 state for cred-old","drain":"cred-old's entry is removed only when the credential it names is deleted","rationale":"v2 holder state cannot be synthesised for a credential issued under v1 - the issuance handshake cannot be replayed - so coexistence is the steady state, not a transition"}}
