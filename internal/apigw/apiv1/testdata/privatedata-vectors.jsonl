{"id":"delivered-secret-strip-001","description":"Strip org.siros.secret_seed from the response credential_metadata before merging into display metadata; seed goes only to the secret store","tags":["delivered-secret","strip-before-merge","display-metadata"],"version":"3","sections":["5A"],"inputs":{"cases":[{"name":"seed stripped, response display overwrites","issuerCredentialMetadata":{"display":[{"name":"Nym","locale":"en"}],"org.siros.secret_seed":{"namespaces":["org.siros.nym_auth"]}},"responseCredentialMetadata":{"display":[{"name":"Nym v2","locale":"en"}],"org.siros.secret_seed":{"org.siros.nym_auth":"00112233445566778899aabbccddeeff"}},"expected":{"strippedResponse":{"display":[{"name":"Nym v2","locale":"en"}]},"mergedDisplayMetadata":{"display":[{"name":"Nym v2","locale":"en"}],"org.siros.secret_seed":{"namespaces":["org.siros.nym_auth"]}},"storedMetadata":[{"type":"org.siros.secret_seed","value":{"org.siros.nym_auth":"00112233445566778899aabbccddeeff"}}]}},{"name":"seed only in response, no issuer advertisement","issuerCredentialMetadata":{"display":[{"name":"Nym","locale":"en"}]},"responseCredentialMetadata":{"org.siros.secret_seed":{"org.siros.nym_auth":"00112233445566778899aabbccddeeff"}},"expected":{"strippedResponse":{},"mergedDisplayMetadata":{"display":[{"name":"Nym","locale":"en"}]},"storedMetadata":[{"type":"org.siros.secret_seed","value":{"org.siros.nym_auth":"00112233445566778899aabbccddeeff"}}]}},{"name":"unknown member survives the merge, seed does not","issuerCredentialMetadata":{"display":[{"name":"Nym","locale":"en"}]},"responseCredentialMetadata":{"com.example.x":{"a":1},"org.siros.secret_seed":{"org.siros.nym_auth":"00112233445566778899aabbccddeeff"}},"expected":{"strippedResponse":{"com.example.x":{"a":1}},"mergedDisplayMetadata":{"display":[{"name":"Nym","locale":"en"}],"com.example.x":{"a":1}},"storedMetadata":[{"type":"org.siros.secret_seed","value":{"org.siros.nym_auth":"00112233445566778899aabbccddeeff"}}]}}]},"expected":{"rule":"mer