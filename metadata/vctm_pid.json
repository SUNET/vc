      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "City of birth",
          "description": "Municipality, city, town, or village where the person was born."
        }
      ]
    },
    {
      "path": [
        "place_of_birth",
        "region"
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
