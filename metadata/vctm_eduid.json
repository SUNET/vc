{
  "name": "eduID Credential",
  "description": "A verifiable credential for educational identity, based on PID Rulebook (ARF Annex 3.01). Provides identity attributes sourced from the eduID SAML2 IdP for students and staff within the education and research sector.",
  "display": [
    {
      "locale": "en-US",
      "name": "eduID",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "data:image/svg+xml;base64,"
          },
          "background_color": "#ffffff",
          "text_color": "#222222"
        },
        "svg_templates": [
          {
            "uri": "data:image/svg+xml;base64,",
            "properties": {
              "orientation": "landscape",
              "color_scheme": "light",
              "contrast": "normal"
            }
          }
        ]
      }
    }
  ],
  "claims": [
    {
      "path": [
        "family_name"
      ],
      "mandatory": true,
      "sd": "always",
      "svg_id": "family_name",
      "display": [
        {
          "locale": "en-US",
          "label": "Last name",
          "description": "Current last name(s) or surname(s). Sourced from SAML attribute sn."
        }
      ]
    },
    {
      "path": [
        "given_name"
      ],
      "mandatory": true,
      "sd": "always",
      "svg_id": "given_name",
      "display": [
        {
          "locale": "en-US",
          "label": "First name",
          "description": "Current first name(s), including middle name(s) if applicable. Sourced from SAML attribute givenName."
        }
      ]
    },
    {
      "path": [
        "name"
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Legal name",
          "description": "Full legal name. Sourced from SAML attribute norEduPersonLegalName."
        }
      ]
    },
    {
      "path": [
        "birthdate"
      ],
      "mandatory": false,
      "sd": "always",
      "svg_id": "birth_date",
      "display": [
        {
          "locale": "en-US",
          "label": "Date of birth",
          "description": "Full birth date (day, month, year). Sourced from SAML attribute schacDateOfBirth."
        }
      ]
    },
    {
      "path": [
        "nationalities"
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Nationalities",
          "description": "Country or countries as ISO 3166-1 alpha-2 codes. Sourced from SAML attribute c (alpha-2) or co (country name, converted to alpha-2)."
        }
      ]
    },
    {
      "path": [
        "nationalities",
        null
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Nationality",
          "description": "Country of nationality as ISO 3166-1 alpha-2 code."
        }
      ]
    },
    {
      "path": [
        "personal_administrative_number"
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Personal ID",
          "description": "Swedish personal identity number (personnummer). Sourced from SAML attribute personalIdentityNumber."
        }
      ]
    },
    {
      "path": [
        "email"
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Email",
          "description": "Person's email address. Sourced from SAML attribute mail."
        }
      ]
    },
    {
      "path": [
        "preferred_username"
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Username",
          "description": "Preferred username or principal name. Sourced from SAML attribute eduPersonPrincipalName (eppn)."
        }
      ]
    },
    {
      "path": [
        "assurance"
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Assurance",
          "description": "Identity assurance level URIs. Sourced from SAML attribute eduPersonAssurance."
        }
      ]
    },
    {
      "path": [
        "assurance",
        null
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Assurance level",
          "description": "Individual assurance level URI."
        }
      ]
    },
    {
      "path": [
        "date_of_expiry"
      ],
      "mandatory": true,
      "sd": "never",
      "svg_id": "expiry_date",
      "display": [
        {
          "locale": "en-US",
          "label": "Expiry date",
          "description": "End date of the document's validity."
        }
      ]
    },
    {
      "path": [
        "issuing_authority"
      ],
      "mandatory": true,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Issuing authority",
          "description": "Name of the issuing body or country."
        }
      ]
    },
    {
      "path": [
        "issuing_country"
      ],
      "mandatory": true,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Issuing country",
          "description": "Country where the document was issued, as an ISO 3166-1 alpha-2 code."
        }
      ]
    },
    {
      "path": [
        "date_of_issuance"
      ],
      "mandatory": false,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Issue date",
          "description": "Start date of the document's validity."
        }
      ]
    },
    {
      "path": [
        "trust_anchor"
      ],
      "mandatory": false,
      "sd": "never",
      "display": [
        {
          "locale": "en-US",
          "label": "Trust anchor",
          "description": "The trust anchor used to verify the document."
        }
      ]
    }
  ]
}
