{
  "description": "2008-10-10..2009-10-08 is 364 days inclusive: below the 365-day minimum.",
  "query": {
    "id": "nym_attestation",
    "format": "zkp_req",
    "meta": {
      "source_format": "mso_mdoc",
      "doctype_value": "eu.europa.ec.eudi.nym_auth.1"
    },
    "_req": [
      {
        "fn_id": "age_check",
        "return": "age",
        "params": {
          "ge": "2008-10-10",
          "le": "2009-10-08"
        }
      }
    ]
  },
  "expect": {
    "error": "age_check_span_too_short"
  }
}
