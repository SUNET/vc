{
  "description": "proof uses the standard alphabet ('+' and '/').",
  "query": {
    "id": "nym_attestation",
    "format": "circuit_zk",
    "meta": {
      "doctype_value": "eu.europa.ec.eudi.nym_auth.1"
    },
    "req": [
      {
        "id": "pseudonym-v1-sha256",
        "return": "nym-123",
